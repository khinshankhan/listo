package views

import (
	"fmt"
	"strings"
)

// BrowsePage is the catalog: filters, then shelves or the filtered grid. The
// filters wait for "apply" rather than jumping on change.
templ BrowsePage(b Browse) {
	<div class="flex flex-col gap-6">
		<header class="flex flex-wrap items-center justify-between gap-3">
			<h1 class="font-heading text-24 leading-8 font-semibold tracking-[-0.03em] text-foreground-strong">browse</h1>
			<nav class="flex gap-[7px]" aria-label="view">
				for _, vl := range b.Views {
					@Link(LinkProps{Href: vl.Href, Variant: LinkNone, Monochrome: true, Current: vl.Active, Class: sortClass(vl.Active)}) {
						{ vl.Label }
					}
				}
			</nav>
		</header>
		<form action="/entries" method="get" aria-label="filter the catalog" class="grid grid-cols-2 items-end gap-3 border-b border-border pb-[22px] md:grid-cols-[repeat(5,minmax(0,200px))_auto]">
			for _, f := range b.Filters {
				<div class="flex min-w-0 flex-col gap-[7px]">
					<label for={ "filter-" + f.Name } class="font-mono text-[10px] leading-3 tracking-[0.1em] text-foreground-muted uppercase">{ f.Label }</label>
					<div class="relative">
						<select
							id={ "filter-" + f.Name }
							name={ f.Name }
							disabled?={ f.Disabled }
							class={ "h-[38px] w-full cursor-pointer appearance-none disabled:cursor-not-allowed rounded-lg border border-border bg-background-2 pr-8 pl-[13px] text-13 leading-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stark-contrast", filterClass(f) }
						>
							for _, o := range f.Options {
								<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
							}
						</select>
						<svg width="11" height="11" viewBox="0 0 12 12" class="pointer-events-none absolute top-1/2 right-[13px] -translate-y-1/2 text-foreground-muted" aria-hidden="true">
							<path d="M2.8 4.5L6 7.8l3.2-3.3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
					</div>
				</div>
			}
			if b.KeepView != "" {
				<input type="hidden" name="view" value={ b.KeepView }/>
			}
			// the same in every state, so applying doesn't shift the row
			<button type="submit" class="col-span-2 h-[38px] cursor-pointer justify-self-start rounded-lg bg-foreground-strong px-4 text-13 leading-4 font-semibold text-background-2 hover:bg-cream-10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stark-contrast md:col-span-1">apply</button>
		</form>
		if b.Filtered {
			<div class="flex flex-col gap-4">
				<div class="flex items-baseline gap-4">
					<h2 id="matches" class="text-20 leading-6 font-semibold tracking-[-0.025em] text-foreground-strong">{ count(b.Total, "entry", "entries") }</h2>
					@Link(LinkProps{Href: "/entries", Variant: LinkNone, Class: "text-12 leading-4 font-semibold text-accent-11"}) {
						clear filters
					}
				</div>
				if len(b.Cards) > 0 {
					@entryView(b.View, b.Cards)
				} else {
					<p class="rounded-[10px] border border-dashed border-border px-[18px] py-4 text-14 text-foreground-muted">
						Nothing matches these filters yet. Try loosening one.
					</p>
				}
				if b.Pages > 1 {
					<nav class="flex items-center justify-between gap-3 border-t border-border pt-4" aria-label="pages">
						if b.Prev != "" {
							@Link(LinkProps{Href: b.Prev, Variant: LinkNone, Class: "text-13 leading-4 font-semibold text-accent-11"}) {
								<span aria-hidden="true">&lsaquo;</span> previous
							}
						} else {
							<span></span>
						}
						<span class="font-mono text-12 leading-4 text-foreground-muted">page { fmt.Sprint(b.Page) } of { fmt.Sprint(b.Pages) }</span>
						if b.Next != "" {
							@Link(LinkProps{Href: b.Next, Variant: LinkNone, Class: "text-13 leading-4 font-semibold text-accent-11"}) {
								next <span aria-hidden="true">&rsaquo;</span>
							}
						} else {
							<span></span>
						}
					</nav>
				}
			</div>
		} else {
			if len(b.Shelves) > 0 {
				for _, s := range b.Shelves {
					<section class="flex flex-col gap-4" aria-labelledby={ "shelf-" + s.ID }>
						<div class="flex items-baseline justify-between gap-3">
							<h2 id={ "shelf-" + s.ID } class="text-20 leading-6 font-semibold tracking-[-0.025em] text-foreground-strong">{ s.Title }</h2>
							@Link(LinkProps{Href: s.Href, Variant: LinkNone, Class: "text-12 leading-4 font-semibold text-accent-11"}) {
								view all<span class="sr-only">{ " " + s.Title }</span>
							}
						</div>
						if b.View == "cards" {
							@cardRow(s.Title, s.Cards)
						} else {
							@entryView(b.View, s.Cards[:min(len(s.Cards), listShelf)])
						}
					</section>
				}
			} else {
				<p class="rounded-[10px] border border-dashed border-border px-[18px] py-4 text-14 text-foreground-muted">
					Nothing to browse here yet. The catalog grows one entry at a time.
				</p>
			}
		}
	</div>
}

// entryView shows entries the chosen way: covers, a list with small covers,
// or plain text.
templ entryView(view string, cards []Card) {
	switch view {
		case "list":
			@entryList(cards, true)
		case "text":
			@entryList(cards, false)
		default:
			@cardGrid(cards)
	}
}

// entryList is entries as rows, with a small cover or without.
templ entryList(cards []Card, covers bool) {
	<ul class="flex flex-col border-t border-border-subtle">
		for _, c := range cards {
			if covers {
				<li class="flex items-center gap-4 border-b border-border-subtle px-3 py-[11px]">
					<span class="h-[46px] w-[33px] shrink-0 rounded-sm bg-placeholder" aria-hidden="true"></span>
					<span class="flex min-w-0 flex-col gap-1">
						@Link(LinkProps{Href: c.Href, Variant: LinkNone, Class: "text-14 leading-[18px] font-semibold wrap-break-word text-foreground-strong"}) {
							{ c.Title }
						}
						@cardMeta(c, "")
					</span>
				</li>
			} else {
				<li class="flex flex-col gap-1 border-b border-border-subtle px-3 py-2.5 sm:flex-row sm:items-baseline sm:gap-4">
					@Link(LinkProps{Href: c.Href, Variant: LinkNone, Class: "text-14 leading-[18px] font-semibold wrap-break-word text-foreground-strong"}) {
						{ c.Title }
					}
					@cardMeta(c, "sm:ml-auto sm:shrink-0")
				</li>
			}
		}
	</ul>
}

// cardMeta is what an entry is, a link to everything of that format, then
// when and how long.
templ cardMeta(c Card, class string) {
	<span class={ "text-12 leading-4 text-foreground-muted", class }>
		@formatLink(c.Format, c.FormatHref, "")
		if c.Meta != "" {
			{ " · " + c.Meta }
		}
	</span>
}

// formatLink is a format, quiet like the text around it until pointed at,
// leading to everything else in it. LinkNone brings the focus ring and the
// hover colour.
templ formatLink(label, href, class string) {
	@Link(LinkProps{Href: href, Variant: LinkNone, Class: strings.TrimSpace("underline-offset-2 hover:underline " + class)}) {
		{ label }
	}
}

// cardGrid is entries as covers: two across on a phone, then as many as fit.
templ cardGrid(cards []Card) {
	<ul class="grid grid-cols-2 gap-x-[18px] gap-y-6 sm:grid-cols-[repeat(auto-fill,minmax(150px,1fr))]">
		for _, c := range cards {
			@card(c)
		}
	</ul>
}

// cardRow is a shelf of covers in one row, scrolling sideways when the screen
// can't fit them all.
templ cardRow(title string, cards []Card) {
	// the scroller clips, so the list pads itself by a focus ring's reach and
	// the row steps back as far: the end cards' rings show, the covers stay put.
	// The scroll padding keeps a ring in view when focus scrolls a card in
	<div class="-mx-1 scroll-px-1 overflow-x-auto rounded-sm pb-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stark-contrast" tabindex="0" role="region" aria-label={ title + ", scrolls sideways" }>
		<ul class="grid w-max auto-cols-[140px] grid-flow-col gap-x-[18px] px-1 sm:auto-cols-[150px]">
			for _, c := range cards {
				@card(c)
			}
		</ul>
	</div>
}

// card is one entry's cover, title and what it is.
templ card(c Card) {
	<li class="flex min-w-0 flex-col gap-[10px]">
		<span class="aspect-[172/250] rounded-[9px] bg-placeholder" aria-hidden="true"></span>
		<span class="flex flex-col gap-1">
			@Link(LinkProps{Href: c.Href, Variant: LinkNone, Class: "text-14 leading-[19px] font-semibold tracking-[-0.012em] wrap-break-word text-foreground-strong"}) {
				{ c.Title }
			}
			@cardMeta(c, "")
		</span>
	</li>
}
