package views

import "fmt"

templ NotFound() {
	<h1 class="font-heading text-32 font-semibold tracking-tight text-foreground-strong">not found</h1>
	<p class="mt-2">
		@Link(LinkProps{Href: "/"}) {
			back home
		}
	</p>
}

// EntryPage is all HTML, for crawlers and link previews.
templ EntryPage(e Entry) {
	<div class="flex flex-col gap-6">
		<nav class="flex items-center gap-[7px]" aria-label="breadcrumb">
			@Link(LinkProps{Href: "/entries", Variant: LinkNav, Class: breadcrumbClass}) {
				catalog
			}
			<span class="text-12 leading-4 text-border" aria-hidden="true">/</span>
			@Link(LinkProps{Href: e.MediumHref, Variant: LinkNav, Class: breadcrumbClass}) {
				{ e.Medium }
			}
		</nav>
		<article class="flex flex-col gap-9 md:flex-row">
			// the rail follows the body on phones
			<div class="order-last flex shrink-0 flex-col gap-4 md:order-none md:w-[210px]">
				if e.Next != nil {
					<div class="hidden md:block">
						@nextUnit(*e.Next)
					</div>
				}
				@cover(e.Cover, entrySlot)
				@factsCard(e.Facts)
				if len(e.Links) > 0 {
					<ul class="flex flex-col rounded-[10px] border border-border bg-background-2" aria-label="elsewhere">
						for i, l := range e.Links {
							<li class={ "flex justify-between gap-3 px-[13px] py-[9px]", templ.KV("border-t border-border-subtle", i > 0) }>
								@Link(LinkProps{Href: l.Href, Class: "text-12 leading-4 text-accent-11"}) {
									{ l.Site }
								}
								<span class="font-mono text-11 leading-4 text-foreground-muted">{ l.ID }</span>
							</li>
						}
					</ul>
				}
			</div>
			<div class="flex min-w-0 flex-1 flex-col gap-[22px]">
				<header class="flex flex-col gap-[10px]">
					<p class="flex flex-wrap items-center gap-[7px]">
						for i, part := range e.Eyebrow {
							if i > 0 {
								<span class="inline-block size-[3px] shrink-0 rounded-full bg-border" aria-hidden="true"></span>
							}
							if part.Href != "" {
								@formatLink(part.Text, part.Href, "font-mono text-11 leading-[14px] tracking-wide text-foreground-muted uppercase")
							} else {
								<span class="font-mono text-11 leading-[14px] tracking-wide text-foreground-muted uppercase">{ part.Text }</span>
							}
						}
					</p>
					<h1 class="font-heading text-32 leading-10 font-semibold tracking-tight wrap-break-word text-foreground-strong sm:text-44 sm:leading-12">{ e.Title }</h1>
					if len(e.Titles) > 0 {
						<dl class="flex flex-col gap-[3px]">
							for _, t := range e.Titles {
								<div class="flex items-baseline gap-2">
									<dt class="w-[78px] shrink-0 font-mono text-[10px] leading-3 text-foreground-muted uppercase">{ t.Kind }</dt>
									<dd class="text-13 leading-4 text-foreground-muted" lang={ t.Lang }>{ t.Title }</dd>
								</div>
							}
						</dl>
					}
					@partOf(e.Groups)
				</header>
				if e.Description != "" {
					<p class="max-w-[640px] text-15 leading-[25px] text-foreground">{ e.Description }</p>
				}
				// on phones the rail comes last, so what's next comes up here
				if e.Next != nil {
					<div class="md:hidden">
						@nextUnit(*e.Next)
					</div>
				}
				if len(e.Tags) > 0 {
					<ul class="flex flex-wrap gap-[7px]" aria-label="tags">
						for _, tag := range e.Tags {
							<li class="flex h-[27px] items-center rounded-full border border-border bg-background-2 px-3 text-12 leading-4 text-foreground-strong">{ tag }</li>
						}
					</ul>
				}
				if len(e.Episodes) > 0 {
					@episodeList(e.Episodes)
				}
				if len(e.Relations) > 0 {
					<section class="flex flex-col gap-3 pt-1">
						<h2 class="border-b border-border pb-[10px] text-20 leading-6 font-semibold tracking-[-0.025em] text-foreground-strong">also in this series</h2>
						<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
							for _, r := range e.Relations {
								@relationCard(r)
							}
						</ul>
					</section>
				}
			</div>
		</article>
	</div>
}

// factsCard is the rail's key facts, label left and value right.
templ factsCard(facts []Fact) {
	<dl class="flex flex-col rounded-[10px] border border-border bg-background-2">
		for i, f := range facts {
			<div class={ "flex justify-between gap-3 px-[13px] py-[9px]", templ.KV("border-t border-border-subtle", i > 0) }>
				<dt class="text-12 leading-4 text-foreground-muted">{ f.Label }</dt>
				<dd class="text-right text-12 leading-4 font-semibold text-foreground-strong">
					if f.Href != "" {
						@formatLink(f.Value, f.Href, "")
					} else {
						{ f.Value }
					}
				</dd>
			</div>
		}
	</dl>
}

// relationCard is one related work and how it relates.
templ relationCard(r Related) {
	<li class="flex items-center gap-[13px] rounded-[10px] border border-border bg-background-2 p-[14px]">
		<span class="h-[52px] w-[37px] shrink-0 rounded-sm bg-placeholder" aria-hidden="true"></span>
		<div class="flex min-w-0 flex-col gap-[3px]">
			@Link(LinkProps{Href: r.Href, Variant: LinkNone, Class: "text-14 leading-[18px] font-semibold text-foreground-strong"}) {
				{ r.Title }
			}
			<span class="text-12 leading-4 text-foreground-muted">{ r.Meta }</span>
			<span class="pt-[2px] font-mono text-[10px] leading-3 tracking-[0.04em] text-foreground-muted uppercase">{ r.Reading }</span>
			if r.Anchor != "" {
				<span class="font-mono text-11 leading-4 text-foreground-muted">{ r.Anchor }</span>
			}
			if r.Note != "" {
				<span class="text-12 leading-4 text-foreground-muted">{ r.Note }</span>
			}
		</div>
	</li>
}

// orderingPanel is one curated path: its name and rationale, then each
// position, with forks as pick-one choices.
templ orderingPanel(o Ordering) {
	@panel(o.Kind + " order") {
		<li class="px-4 py-3">
			<p>
				@Link(LinkProps{Href: o.Href, Variant: LinkNone, Class: "font-semibold text-foreground-strong"}) {
					{ o.Name }
				}
			</p>
			if o.Rationale != "" {
				<p class="mt-1 text-14 text-foreground-muted">{ o.Rationale }</p>
			}
		</li>
		for _, pos := range o.Positions {
			if pos.Section != "" {
				<li class="bg-background-1 px-4 py-2 text-14 font-semibold text-foreground">{ pos.Section }</li>
			}
			<li class="flex gap-4 px-4 py-3">
				<span class="w-8 shrink-0 font-mono text-13 text-foreground-muted">{ pos.Number }</span>
				<div class="min-w-0 flex-1">
					if pos.PickOne() {
						<p class="font-mono text-11 tracking-wide text-foreground-muted uppercase">pick one</p>
						<ol class="mt-2 space-y-2">
							for _, c := range pos.Choices {
								<li class="rounded-md border border-border-subtle px-3 py-2">
									@steps(c.Steps)
								</li>
							}
						</ol>
					} else {
						@steps(pos.Choices[0].Steps)
					}
				</div>
			</li>
		}
	}
}

// steps is one choice's entries, in order.
templ steps(steps []Step) {
	<ol class="space-y-2">
		for _, st := range steps {
			<li>
				<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
					@Link(LinkProps{Href: st.Href, Variant: LinkNone, Class: "font-semibold text-foreground-strong"}) {
						{ st.Title }
					}
					if st.Units != "" {
						<span class="font-mono text-13 text-foreground-muted">{ st.Units }</span>
					}
					if st.Necessity != "" {
						<span class="ml-auto font-mono text-11 tracking-wide text-foreground-muted uppercase">{ st.Necessity }</span>
					}
				</div>
				if st.Note != "" {
					<p class="mt-1 text-14 text-foreground-muted">{ st.Note }</p>
				}
			</li>
		}
	</ol>
}

// partOf is the groups a node sits in, nearest first: "#1 in Detective Conan
// films / part of Detective Conan".
templ partOf(groups []GroupRef) {
	if len(groups) > 0 {
		<p class="mt-2 text-14 text-foreground">
			for i, g := range groups {
				if i > 0 {
					<span class="text-foreground-subtle" aria-hidden="true">&nbsp;/&nbsp;</span>
				}
				if g.Position != "" {
					<span class="font-mono text-foreground-muted">{ g.Position }</span> in
				} else {
					<span class="text-foreground-muted">part of</span>
				}
				@Link(LinkProps{Href: g.Href}) {
					{ g.Name }
				}
			}
		</p>
	}
}

templ relationsPanel(relations []Related) {
	if len(relations) > 0 {
		@panel("relations") {
			for _, r := range relations {
				<li class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-4">
					<span class="font-mono text-11 tracking-wide text-foreground-muted uppercase sm:w-36 sm:shrink-0">{ r.Reading }</span>
					@Link(LinkProps{Href: r.Href, Variant: LinkNone, Class: "font-semibold text-foreground-strong"}) {
						{ r.Title }
					}
					if r.Anchor != "" {
						<span class="font-mono text-13 text-foreground-muted">{ r.Anchor }</span>
					}
					<span class="font-mono text-13 text-foreground-muted sm:ml-auto">{ r.Meta }</span>
					if r.Note != "" {
						<p class="text-14 text-foreground-muted sm:basis-full sm:pl-40">{ r.Note }</p>
					}
				</li>
			}
		}
	}
}

templ titlesPanel(titles []Title) {
	if len(titles) > 0 {
		@panel("titles") {
			for _, t := range titles {
				<li class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:items-baseline sm:gap-4">
					<span class="font-mono text-11 tracking-wide text-foreground-muted uppercase sm:w-36 sm:shrink-0">{ t.Kind }</span>
					<span class="text-foreground-strong" lang={ t.Lang }>{ t.Title }</span>
				</li>
			}
		}
	}
}

templ linksPanel(links []SiteLink) {
	if len(links) > 0 {
		@panel("elsewhere") {
			for _, l := range links {
				<li class="flex items-baseline gap-4 px-4 py-3">
					@Link(LinkProps{Href: l.Href}) {
						{ l.Site }
					}
					<span class="ml-auto font-mono text-13 text-foreground-muted">{ l.ID }</span>
				</li>
			}
		}
	}
}

// panel is one titled section of a page: a mono eyebrow over a raised list.
templ panel(eyebrow string) {
	<section class="mt-12">
		<h2 class="font-mono text-12 tracking-wide text-foreground-muted uppercase">{ eyebrow }</h2>
		<ul class="mt-3 divide-y divide-border-subtle rounded-lg border border-border bg-background-2">
			{ children... }
		</ul>
	</section>
}

// nextUnit is what airs next and how soon.
templ nextUnit(n NextUnit) {
	<p class="flex flex-col gap-[5px] rounded-[10px] bg-accent-3 px-4 py-[14px]">
		<span class="font-mono text-[10px] leading-3 tracking-[0.1em] text-accent-11 uppercase">next to air</span>
		<span class="text-[19px] leading-6 font-semibold tracking-[-0.02em] text-foreground-strong">{ n.Label } { n.In }</span>
	</p>
}

// episodeList is an entry's units with what's known of each; past the first
// five, the rest fold away.
templ episodeList(eps []Episode) {
	<section class="flex flex-col gap-[14px] pt-1" aria-labelledby="episodes">
		<h2 id="episodes" class="border-b border-border pb-[10px] text-20 leading-6 font-semibold tracking-[-0.025em] text-foreground-strong">episodes</h2>
		<ol class="flex flex-col">
			for _, ep := range eps[:min(len(eps), shownEpisodes)] {
				@episodeRow(ep)
			}
		</ol>
		if len(eps) > shownEpisodes {
			<details class="group">
				<summary class="flex cursor-pointer list-none items-center gap-[7px] text-12 leading-4 font-semibold text-accent-11 group-open:sr-only [&::-webkit-details-marker]:hidden">
					show all { fmt.Sprint(len(eps)) }
				</summary>
				<ol class="flex flex-col">
					for _, ep := range eps[shownEpisodes:] {
						@episodeRow(ep)
					}
				</ol>
			</details>
		}
	</section>
}

templ episodeRow(ep Episode) {
	<li class="flex items-center gap-[14px] border-b border-border-subtle px-[18px] py-3">
		<span class={ "w-[52px] shrink-0 font-mono text-13 leading-4", templ.KV("text-foreground-muted", ep.Upcoming), templ.KV("text-foreground-strong", !ep.Upcoming) }>{ ep.Number }</span>
		if ep.Upcoming {
			<span class="min-w-0 flex-1 text-14 leading-[18px] text-foreground-muted">not yet aired</span>
		} else if ep.Title != "" {
			<span class="min-w-0 flex-1 text-14 leading-[18px] font-medium wrap-break-word text-foreground-strong">{ ep.Title }</span>
		} else {
			<span class="min-w-0 flex-1 text-14 leading-[18px] text-foreground-muted">untitled</span>
		}
		<span class="shrink-0 text-right text-12 leading-4 text-foreground-muted">{ ep.When }</span>
	</li>
}
