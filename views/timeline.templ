package views

import "fmt"

// TimelineSection is a group's works by year, its spoilers behind a checkbox
// and the drawing in words for screen readers. Too narrow for the drawing, it
// shows the outline instead.
templ TimelineSection(t *Timeline, group string) {
	<section id="timeline" class="timeline flex scroll-mt-6 flex-col gap-4">
		@sectionHead("timeline", "what came out when, and what leads to what")
		<figure class="flex flex-col gap-[14px] rounded-xl border border-border bg-background-2 px-4 pt-5 pb-[18px] sm:px-[19px]">
			// hidden, the island never loads
			<div class="hidden sm:block">
				@Island("timeline", t, "visible") {
					@timelineDrawing(t)
				}
			</div>
			@timelineOutline(t)
			<figcaption class="flex flex-wrap items-center gap-x-[22px] gap-y-2 text-12 leading-4 text-foreground-muted sm:px-4">
				<span class="hidden sm:contents">
					if len(t.Boxes) > 0 {
						@mapLegend("crossover, reboot or other link", "part of "+group)
					} else {
						@mapLegend("crossover, reboot or other link", "")
					}
				</span>
				if t.Undated > 0 {
					<span>{ count(t.Undated, "entry", "entries") } without a date left off</span>
				}
				if t.Spoilers {
					<label class="flex cursor-pointer items-center gap-2 sm:ml-auto">
						// in step with ?spoilers=show; off, so Firefox doesn't bring back
						// a tick the address no longer has
						<input type="checkbox" autocomplete="off" checked?={ t.Revealed } class="timeline-reveal size-[14px] cursor-pointer accent-accent-9 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stark-contrast"/>
						show spoilers
					</label>
				}
			</figcaption>
		</figure>
		<ul class="sr-only">
			for _, line := range t.Lines {
				<li class={ templ.KV("timeline-spoiler", line.Spoiler) }>{ line.Text }</li>
			}
		</ul>
	</section>
}

// timelineDrawing is the timeline as plain SVG, until the island takes over
// or without script: the same cards and lines, from the same layout.
templ timelineDrawing(t *Timeline) {
	<div class="overflow-x-auto" tabindex="0" role="region" aria-label="timeline, scrolls sideways">
		// as wide as the island draws it, so nothing moves when it takes over
		<svg viewBox={ fmt.Sprintf("0 0 %d %d", t.Width, t.Height) } width={ fmt.Sprint(t.Width) } height={ fmt.Sprint(t.Height) } class="mx-auto block max-w-none font-body">
			<defs>
				<marker id="timeline-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
					<path d="M0 1 10 5 0 9z" fill="var(--color-foreground-muted)"></path>
				</marker>
			</defs>
			<g aria-hidden="true">
				for _, tick := range t.Ticks {
					<line x1={ fmt.Sprint(tick.X) } y1="0" x2={ fmt.Sprint(tick.X) } y2={ fmt.Sprint(t.Height - 20) } stroke="var(--color-border-subtle)" stroke-dasharray="1 3"></line>
					<text x={ fmt.Sprint(tick.X) } y={ fmt.Sprint(t.Height - 6) } text-anchor="middle" font-size="10" class="font-mono" fill="var(--color-foreground-muted)">{ tick.Label }</text>
				}
				for _, b := range t.Boxes {
					<rect x={ fmt.Sprint(b.X) } y={ fmt.Sprint(b.Y) } width={ fmt.Sprint(b.W) } height={ fmt.Sprint(b.H) } rx="12" fill="none" stroke="var(--color-border)" stroke-dasharray="5 4"></rect>
				}
				for _, l := range t.Links {
					if l.Sequel {
						<path class={ templ.KV("timeline-spoiler", l.Spoiler) } d={ l.Path } fill="none" stroke="var(--color-foreground-muted)" stroke-width="1.25" marker-end="url(#timeline-arrow)"></path>
					} else {
						<path class={ templ.KV("timeline-spoiler", l.Spoiler) } d={ l.Path } fill="none" stroke="var(--color-foreground-subtle)" stroke-width="1.25" stroke-linecap="round" stroke-dasharray="1.5 4"></path>
					}
				}
				// box names go over the lines, haloed so one running under doesn't
				// strike them through
				for _, b := range t.Boxes {
					<text x={ fmt.Sprint(b.X + 17) } y={ fmt.Sprint(b.Y + 27) } font-size="14" font-weight="700" fill="var(--color-foreground-strong)" { halo... }>{ b.Name }</text>
				}
			</g>
			for _, w := range t.Works {
				@timelineWork(w)
			}
			<g aria-hidden="true">
				for _, l := range t.Links {
					if l.Label != "" {
						<g class={ templ.KV("timeline-spoiler", l.Spoiler) }>
							<rect x={ fmt.Sprint(l.LabelLeft()) } y={ fmt.Sprint(l.LabelY - 7) } width={ fmt.Sprint(l.LabelW) } height="14" rx="7" fill="var(--color-background-2)"></rect>
							<text x={ fmt.Sprint(l.LabelLeft() + l.LabelW/2) } y={ fmt.Sprint(l.LabelY + 4) } text-anchor="middle" font-size="11" fill="var(--color-foreground-muted)">{ l.Label }</text>
						</g>
					}
				}
			</g>
		</svg>
	</div>
}

// timelineOutline is the timeline for a phone: each box's works row by row,
// what hangs off a row indented under it.
templ timelineOutline(t *Timeline) {
	<div class="flex flex-col gap-5 sm:hidden">
		for _, part := range t.Outline {
			<div class="flex flex-col gap-1">
				if part.Name != "" {
					<h3 class="text-14 leading-5 font-bold text-foreground-strong">{ part.Name }</h3>
				}
				<ol class="flex flex-col">
					for _, item := range part.Items {
						<li class={ "flex flex-col gap-[2px] py-2", indent(item.Depth) }>
							if item.Via != "" {
								<span class={ "text-11 leading-4 text-foreground-muted", templ.KV("timeline-spoiler", item.Spoiler) }>{ item.Via }</span>
							}
							<a href={ item.Href } class="self-start rounded-sm text-14 leading-5 font-semibold text-foreground-strong hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stark-contrast">{ item.Name }</a>
							if item.Formats != "" {
								<span class="text-12 leading-4 text-foreground-muted">{ item.Formats } · { item.Years }</span>
							}
						</li>
					}
				</ol>
			</div>
		}
	</div>
}

// timelineWork is a work's card: its name, a link to it, over its releases,
// joined when there's more than one.
templ timelineWork(w TimelineWork) {
	<a href={ w.Href } class="timeline-work">
		<rect x={ fmt.Sprint(w.Card.X) } y={ fmt.Sprint(w.Card.Y) } width={ fmt.Sprint(w.Card.W) } height={ fmt.Sprint(w.Card.H) } rx="8" fill="var(--color-background-2)" stroke="var(--color-border)"></rect>
		<text class="timeline-name" x={ fmt.Sprint(w.NameX) } y={ fmt.Sprint(w.NameY) } font-size="13" font-weight="600" fill="var(--color-foreground-strong)">{ w.Name }</text>
		<g aria-hidden="true">
			if len(w.Dots) > 1 {
				<line x1={ fmt.Sprint(w.Dots[0].X) } y1={ fmt.Sprint(w.Y) } x2={ fmt.Sprint(w.Dots[len(w.Dots)-1].X) } y2={ fmt.Sprint(w.Y) } stroke="var(--color-foreground-strong)" stroke-width="3" stroke-linecap="round"></line>
			}
			for _, d := range w.Dots {
				<circle cx={ fmt.Sprint(d.X) } cy={ fmt.Sprint(w.Y) } r="3.75" fill="var(--color-background-2)" stroke="var(--color-foreground-strong)" stroke-width="1.5"></circle>
				if d.Label != "" {
					<text x={ fmt.Sprint(d.LabelX) } y={ fmt.Sprint(w.Y + 18) } text-anchor="middle" font-size="11" fill="var(--color-foreground-muted)">{ d.Label }</text>
				}
			}
		</g>
	</a>
}

// mapLegend is the key to a map's lines and boxes. link says what a dotted
// line is; box, when set, what a dashed box is.
templ mapLegend(link, box string) {
	<span class="flex items-center gap-2">
		<svg width="34" height="10" viewBox="0 0 34 10" class="shrink-0" aria-hidden="true">
			<line x1="1" y1="5" x2="27" y2="5" stroke="var(--color-foreground-muted)" stroke-width="1.25"></line>
			<path d="M26 1.5 32 5 26 8.5z" fill="var(--color-foreground-muted)"></path>
		</svg>
		sequel
	</span>
	<span class="flex items-center gap-2">
		<svg width="34" height="10" viewBox="0 0 34 10" class="shrink-0" aria-hidden="true">
			<path d="M1 5 C12 -2 22 12 33 5" fill="none" stroke="var(--color-foreground-subtle)" stroke-width="1.25" stroke-linecap="round" stroke-dasharray="1.5 4"></path>
		</svg>
		{ link }
	</span>
	if box != "" {
		<span class="flex items-center gap-2">
			<svg width="34" height="10" viewBox="0 0 34 10" class="shrink-0" aria-hidden="true">
				<rect x="1" y="1" width="32" height="8" rx="2" fill="none" stroke="var(--color-border)" stroke-dasharray="5 4"></rect>
			</svg>
			{ box }
		</span>
	}
	<span class="flex items-center gap-2">
		<svg width="34" height="10" viewBox="0 0 34 10" class="shrink-0" aria-hidden="true">
			<line x1="4" y1="5" x2="30" y2="5" stroke="var(--color-foreground-strong)" stroke-width="3" stroke-linecap="round"></line>
			<circle cx="4" cy="5" r="3.5" fill="var(--color-background-2)" stroke="var(--color-foreground-strong)" stroke-width="1.5"></circle>
			<circle cx="30" cy="5" r="3.5" fill="var(--color-background-2)" stroke="var(--color-foreground-strong)" stroke-width="1.5"></circle>
		</svg>
		one work, a release in each medium
	</span>
}
