package views

import (
	"fmt"

	"github.com/khinshankhan/listo/web"
)

// Layout is the page shell: top bar, and the sidebar when there is one.
templ Layout(head Head, tags web.Tags, chrome Chrome) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ head.Title }</title>
			<meta name="description" content={ head.Description }/>
			<meta property="og:site_name" content="listo"/>
			<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
			<meta property="og:title" content={ head.Title }/>
			<meta property="og:description" content={ head.Description }/>
			if head.NoIndex {
				<meta name="robots" content="noindex"/>
			}
			if head.Canonical != "" {
				<link rel="canonical" href={ head.Canonical }/>
				<meta property="og:url" content={ head.Canonical }/>
			}
			// fonts first, so they're fetching before the stylesheet asks
			for _, href := range tags.Fonts {
				<link rel="preload" href={ href } as="font" type="font/woff2" crossorigin/>
			}
			for _, href := range tags.CSS {
				<link rel="stylesheet" href={ href }/>
			}
			<script type="module" src={ tags.Script }></script>
			for _, href := range tags.Preload {
				<link rel="modulepreload" href={ href }/>
			}
		</head>
		<body class="flex min-h-screen flex-col bg-background-1 font-body text-foreground antialiased">
			// first stop for a keyboard, past the top bar and sidebar
			<a href="#content" class="sr-only rounded-md bg-foreground-strong px-4 py-2 text-14 font-semibold text-background-2 focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stark-contrast">skip to content</a>
			@topBar(chrome.Query, chrome.HideSearch, chrome.Sidebar != nil)
			<div class="flex flex-1">
				if chrome.Sidebar != nil {
					@sidebar(*chrome.Sidebar)
				}
				<main id="content" class="min-w-0 flex-1 px-4 pt-6 pb-12 sm:px-10">
					<div class={ templ.KV("max-w-content", !chrome.Wide), templ.KV("mx-auto", chrome.Sidebar == nil) }>
						{ children... }
					</div>
				</main>
			</div>
		</body>
	</html>
}

// topBar is the wordmark corner, browse and search, one height on every page
// whatever it holds. The corner matches the sidebar's width, and only draws
// its edge when there's a sidebar under it. A page that hosts the search
// itself hides it here.
templ topBar(query string, hideSearch, sidebar bool) {
	// stuck to the top, so the cross-page fade always finds it in place. Its
	// view-transition name makes it a stacking context, so it stacks as a
	// whole: raised, or the page's positioned bits cover the search popover
	<header class="sticky top-0 z-20 flex h-topbar shrink-0 border-b border-border bg-background-2 [view-transition-name:top-bar]">
		<div class={ "flex shrink-0 items-center px-4 sm:w-sidebar sm:px-7", templ.KV("lg:border-r lg:border-border", sidebar) }>
			@Wordmark()
		</div>
		<div class="flex min-w-0 flex-1 items-center justify-between gap-[22px] pr-4 sm:px-10">
			// min-w-0 down the row, so the search shrinks on a 320px screen
			<div class="flex min-w-0 flex-1 items-center gap-[14px] sm:gap-[22px]">
				@Link(LinkProps{Href: "/entries", Variant: LinkNav, Class: "text-14 leading-[18px] font-semibold text-accent-11"}) {
					browse
				}
				if !hideSearch {
					@siteSearch(query, false)
				}
			</div>
			<div class="hidden shrink-0 items-center gap-[7px] md:flex">
				<span class="text-14 leading-[18px] font-medium text-foreground-muted">API</span>
				<span class="font-mono text-[10px] leading-[14px] tracking-[0.04em] text-foreground-muted">SOON</span>
			</div>
		</div>
	</header>
}

// siteSearch is the catalog search with suggestions from web/src/search.ts:
// compact in the top bar, or large in a page's hero. Only one may be on a
// page, since the script finds it by id.
templ siteSearch(query string, hero bool) {
	<form
		action="/search"
		method="get"
		role="search"
		class={ "flex min-w-0 items-center rounded-lg border border-border focus-within:outline-2 focus-within:outline-stark-contrast",
			templ.KV("max-w-[420px] flex-1 gap-[9px] bg-background-1 px-3 py-2 sm:relative", !hero),
			templ.KV("relative h-[52px] w-full gap-[10px] rounded-[10px] bg-background-2 px-[14px]", hero) }
	>
		<svg width={ searchIconSize(hero) } height={ searchIconSize(hero) } viewBox="0 0 18 18" class="shrink-0" aria-hidden="true">
			<circle cx="8.2" cy="8.2" r="5.4" fill="none" stroke="var(--color-foreground-subtle)" stroke-width="1.5"></circle>
			<path d="M12.3 12.3l3 3" fill="none" stroke="var(--color-foreground-subtle)" stroke-width="1.5" stroke-linecap="round"></path>
		</svg>
		<label for="site-search" class="sr-only">search the catalog</label>
		<input
			id="site-search"
			name="q"
			type="search"
			value={ query }
			placeholder="search the catalog"
			role="combobox"
			aria-autocomplete="list"
			aria-expanded="false"
			aria-controls="site-search-results"
			autocomplete="off"
			class={ "min-w-0 flex-1 bg-transparent text-foreground-strong outline-none placeholder:text-foreground-muted",
				templ.KV("text-13 leading-4", !hero), templ.KV("text-15 leading-[18px]", hero) }
		/>
		<kbd class="hidden rounded-sm border border-border px-[5px] py-px font-mono text-11 leading-[14px] text-foreground-muted sm:inline-block" title="press / to search">/</kbd>
		@searchPanel(hero)
		// outside the panel: a live region inside a hidden element says nothing
		<p id="site-search-status" role="status" class="sr-only"></p>
	</form>
}

// searchPanel holds the suggestions, filled by web/src/search.ts. In the top
// bar it's a drawer under the bar on phones and a popover under the field from
// sm up; in a hero, always a popover.
templ searchPanel(hero bool) {
	<div
		id="site-search-panel"
		hidden
		class={ "absolute inset-x-0 top-full z-30 border-border bg-background-2 shadow-sm",
			templ.KV("border-b sm:mt-2 sm:rounded-lg sm:border", !hero), templ.KV("mt-2 rounded-lg border text-left", hero) }
	>
		// nothing found, still searching, or a failure: a note, never a row in
		// the listbox, which only ever holds options
		<p id="site-search-note" hidden class="px-3 py-2.5 text-13 text-foreground-muted"></p>
		<ul id="site-search-results" role="listbox" aria-label="suggestions" class="max-h-[60vh] overflow-y-auto py-1"></ul>
		@Link(LinkProps{ID: "site-search-all", Href: "/search", Variant: LinkNone, Class: "block border-t border-border-subtle px-3 py-2.5 text-13 text-accent-11 hover:bg-background-1"}) {
			see all results
		}
	</div>
}

// sidebar is the catalog nav, hidden on small screens. It holds still under
// the top bar and scrolls on its own when it's taller than the screen.
templ sidebar(s Sidebar) {
	<aside class="sticky top-topbar hidden h-[calc(100dvh-var(--spacing-topbar))] w-sidebar shrink-0 flex-col self-start overflow-y-auto border-r border-border bg-background-2 px-5 pt-4 pb-6 lg:flex [scrollbar-gutter:stable] [view-transition-name:sidebar]">
		<nav class="flex flex-col gap-7" aria-label="catalog">
			@sideSection("catalog") {
				for _, m := range s.Media {
					if m.Label == "" {
						@sideLink(m.Href, "everything", m.Count, m.Active)
					} else {
						@sideLink(m.Href, m.Label, m.Count, m.Active)
					}
				}
			}
			if len(s.Franchises) > 0 {
				@sideSection("franchises") {
					for _, f := range s.Franchises {
						@sideLink(f.Href, f.Name, f.Entries, f.Active)
					}
					@Link(LinkProps{Href: "/groups", Variant: LinkNone, Monochrome: true, Current: s.AllFranchises, Class: sideLinkClass(s.AllFranchises)}) {
						<span
							class={ "flex-1 text-14 leading-[18px] tracking-snug",
							templ.KV("font-semibold text-accent-11", s.AllFranchises), templ.KV("font-medium text-foreground-muted", !s.AllFranchises) }
						>all franchises</span>
					}
				}
			}
		</nav>
	</aside>
}

templ sideSection(title string) {
	<div class="flex flex-col gap-0.5">
		<p class="pb-2 pl-2.5 font-mono text-11 leading-[14px] tracking-wide text-foreground-muted uppercase">{ title }</p>
		{ children... }
	</div>
}

templ sideLink(href, label string, n int, active bool) {
	@Link(LinkProps{Href: href, Variant: LinkNone, Monochrome: true, Current: active, Class: sideLinkClass(active)}) {
		<span
			class={ "flex-1 text-14 leading-[18px] tracking-snug",
			templ.KV("font-semibold text-accent-11", active), templ.KV("font-medium text-foreground-strong", !active) }
		>{ label }</span>
		<span
			class={ "shrink-0 font-mono text-11 leading-[14px]",
			templ.KV("text-accent-11", active), templ.KV("text-foreground-muted", !active) }
		>{ fmt.Sprint(n) }</span>
	}
}

// Wordmark is `listo.`, its full stop in the accent.
templ Wordmark() {
	@Link(LinkProps{Href: "/", Variant: LinkNone, Monochrome: true, Class: "font-heading text-[21px] leading-[26px] font-extrabold tracking-[-0.045em] text-foreground-strong"}) {
		listo<span class="text-accent-9">.</span>
	}
}
