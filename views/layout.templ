package views

import "github.com/khinshankhan/listo/web"

// Layout is the page shell.
templ Layout(head Head, tags web.Tags) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ head.Title }</title>
			<meta name="description" content={ head.Description }/>
			<meta property="og:site_name" content="listo"/>
			<meta property="og:title" content={ head.Title }/>
			<meta property="og:description" content={ head.Description }/>
			if head.NoIndex {
				<meta name="robots" content="noindex"/>
			}
			if head.Canonical != "" {
				<link rel="canonical" href={ head.Canonical }/>
				<meta property="og:url" content={ head.Canonical }/>
			}
			for _, href := range tags.CSS {
				<link rel="stylesheet" href={ href }/>
			}
			<script type="module" src={ tags.Script }></script>
			for _, href := range tags.Preload {
				<link rel="modulepreload" href={ href }/>
			}
		</head>
		<body class="min-h-screen bg-background-1 font-body text-foreground">
			<header class="border-b border-border bg-background-2">
				<nav class="mx-auto flex max-w-5xl items-center gap-6 px-6 py-4">
					@Wordmark()
					<a href="/entries" class="text-14 text-foreground-muted hover:text-accent-9">browse</a>
					<a href="/search" class="text-14 text-foreground-muted hover:text-accent-9">search</a>
				</nav>
			</header>
			<main class="mx-auto max-w-5xl px-6 py-12">
				{ children... }
			</main>
		</body>
	</html>
}

// Wordmark is `listo.`, its full stop in the accent.
templ Wordmark() {
	<a href="/" class="mr-auto font-heading text-24 font-extrabold tracking-[-0.045em] text-foreground-strong">
		listo<span class="text-accent-9">.</span>
	</a>
}
